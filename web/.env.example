NEXT_PUBLIC_SANITY_PROJECT_ID=sttir3vc
NEXT_PUBLIC_SANITY_DATASET=production

# Required only if you enable Presentation in Studio (SANITY_STUDIO_ENABLE_PRESENTATION=true)
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Instagram feed blocks
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_PAGE_ID=
INSTAGRAM_LONG_LIVED_USER_TOKEN=

# Auto token refresh (monthly cron)
META_APP_ID=
META_APP_SECRET=
CRON_SECRET=

# Email alerts when refresh fails (Resend — https://resend.com)
INSTAGRAM_ALERT_EMAIL=
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Portfolio <notifications@yourdomain.com>

# Vercel auto-update after token refresh (create token at vercel.com/account/tokens)
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_SLUG=
