{
  "name": "andy-oh-portfolio-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev --host=0.0.0.0",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "migrate:media": "sanity exec ./scripts/migrate-legacy-cms-media.mjs --with-user-token",
    "migrate:project-cms": "sanity exec ./scripts/migrate-project-cms.mjs --with-user-token",
    "migrate:lead-pt": "sanity exec ./scripts/migrate-lead-portable-text.mjs --with-user-token",
    "migrate:bento-collage": "sanity exec ./scripts/migrate-bento-collage.mjs --with-user-token",
    "migrate:more-albums": "sanity exec ./scripts/migrate-more-albums.mjs --with-user-token",
    "seed:monklap-draft": "sanity exec ./scripts/seed-monklap-draft.mjs --with-user-token",
    "seed:monklap-replace": "sanity exec ./scripts/seed-monklap-draft.mjs --with-user-token -- --replace",
    "publish:project": "sanity exec ./scripts/publish-project.mjs --with-user-token --",
    "publish:instagram": "node scripts/publish-instagram.mjs",
    "publish:figma": "node scripts/publish-figma.mjs",
    "figma:diff": "node tools/figma/diff-rest.mjs",
    "test:brief": "node tools/brief.test.mjs",
    "setup:claude": "node scripts/setup-claude.mjs",
    "apply:text-edits": "sanity exec ./scripts/apply-text-edits.mjs --with-user-token --",
    "test:text-edits": "node tools/text-edits.test.mjs",
    "test:figma-sync": "node figma-plugin/code.test.mjs"
  },
  "dependencies": {
    "@sanity/orderable-document-list": "^1.5.1",
    "@sanity/vision": "^5.28.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^5.28.0",
    "sanity-plugin-media": "^4.3.1",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
